# Public address of the deployed site (metadata, robots.txt, sitemap.xml).
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Supabase (content management). Project Settings → API in the Supabase dashboard.
# Leave these empty to run the site on the defaults in src/content.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
